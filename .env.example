# ManertDev — copy shape only. NEVER put real API keys in the project.
#
# Real secrets go ONLY here (outside git / workspace):
#   Windows:  %USERPROFILE%\.manertdev\.env
#   macOS/Linux:  ~/.manertdev/.env

# Non-secret project defaults (ok in project .env.local)
MANERT_PROJECT_NAME=ManertDev
MANERT_PROJECT_DETAILS=In-development security helper CLI
MANERT_SCAN_ROOT=
MANERT_EDITOR=cursor

# These must be set in ~/.manertdev/.env (not here):
# OPENROUTER_API_KEY=sk-or-v1-...              # primary (security keywords)
# OPENROUTER_FALLBACK_API_KEY=sk-or-v1-...     # general chat + failure fallback
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODEL=openrouter/free
# OSSPREY_API_KEY=ospy_...                     # supply-chain malware (dashboard.ossprey.com)
# OSSPREY_API_URL=https://api.ossprey.com
# MODAL_TOKEN_ID=ak-...                        # from: python -m modal setup
# MODAL_TOKEN_SECRET=as-...
# MODAL_PROFILE=alvi83252-dot
# MANERT_PYTHON=python                       # optional python binary for Modal CLI
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
