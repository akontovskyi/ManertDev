# SentinelDev — copy to .env.local and fill in values.
# Never commit real secrets.

# Supabase (fix logs)
# Project URL: https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Legacy JWT anon key OR new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: service_role for admin operations (keep server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: OpenAI-compatible LLM for richer NL answers (falls back to keyword routing)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: Modal API for heavy analysis jobs
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENDPOINT_URL=

# Default scan target (CLI). Leave empty to scan process.cwd()
SENTINEL_SCAN_ROOT=
