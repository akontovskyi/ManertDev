# SentinelDev — copy shape only. NEVER put real API keys in the project.
#
# Real secrets go ONLY here (outside git / workspace):
#   Windows:  %USERPROFILE%\.sentineldev\.env
#   macOS/Linux:  ~/.sentineldev/.env

# Non-secret project defaults (ok in project .env.local)
SENTINEL_PROJECT_NAME=SentinelDev
SENTINEL_PROJECT_DETAILS=In-development security helper CLI
SENTINEL_SCAN_ROOT=
SENTINEL_EDITOR=cursor

# These must be set in ~/.sentineldev/.env (not here):
# OPENROUTER_API_KEY=sk-or-v1-...              # primary (security keywords)
# OPENROUTER_FALLBACK_API_KEY=sk-or-v1-...     # general chat + failure fallback
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODEL=openrouter/free
# OSSPREY_API_KEY=ospy_...                     # supply-chain malware (dashboard.ossprey.com)
# OSSPREY_API_URL=https://api.ossprey.com
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
