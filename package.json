{
  "name": "sentineldev",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered in-development security helper — detect exposure risks, propose safe fixes, never auto-modify.",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca ./node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "cli": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/cli/index.ts",
    "scan": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/cli/index.ts scan",
    "supabase:probe": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/probe-supabase.ts",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "sentineldev": "./dist/cli/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "fast-glob": "^3.3.3",
    "next": "^15.1.6",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
